import { TabWidget, VerticalBox, HorizontalBox, Button, CheckBox, LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";

// Skeleton window for unit A of the acr-launcher plan
// (docs/plans/acr-launcher-v1.md): a status bar plus a three-tab shell.
// Export is still a placeholder here — filled in by a later unit. The
// Record tab (unit C) is implemented in Rust by src/recorder_panel.rs.
// Declarative markup only; all state/logic lives in Rust (src/main.rs,
// src/recorder_panel.rs).
export component AppWindow inherits Window {
    title: "acr_telemetry launcher";
    preferred-width: 640px;
    preferred-height: 420px;

    // Live "is ACC/AC Rally running" text, pushed from Rust's background
    // poll thread (see src/main.rs's status-poll thread and
    // slint::invoke_from_event_loop usage). Placeholder default matches
    // what the poll thread reports before its first successful read.
    in-out property <string> status-text: "ACC/AC Rally: not detected";

    // Record tab state — populated from acr_recorder::config::load_config()
    // at startup by src/recorder_panel.rs, and read back out on Save/Start.
    in-out property <string> recorder-raw-output-dir: "";
    in-out property <string> recorder-notes-dir: "";
    in-out property <bool> recorder-record-graphics: true;
    in-out property <bool> recorder-ring-mode: false;
    in-out property <string> recorder-ring-slots: "8";
    in-out property <string> recorder-ring-prefix: "acc_ring";
    in-out property <bool> recorder-motec-mode: false;

    // Recording status: whether a child process is currently spawned
    // (drives Start/Stop enablement), a short status pill driven by
    // substring-matching the subprocess's stderr (see recorder_panel.rs),
    // a one-line save/error message, and a scrolling raw-output log.
    in-out property <bool> recorder-running: false;
    in-out property <string> recorder-status-pill: "Idle";
    in-out property <string> recorder-status-text: "";
    in-out property <string> recorder-log-text: "";

    callback recorder-save();
    callback recorder-start();
    callback recorder-stop();

    // --- Export tab state (src/export_panel.rs owns the logic; this is
    // just the declarative surface it drives via the generated AppWindow
    // setters/callbacks). ---
    in-out property <string> export-mode-label: "No input selected.";
    in-out property <bool> export-do-csv: true;
    in-out property <bool> export-do-sqlite: false;
    in-out property <string> export-sqlite-path: "";
    in-out property <bool> export-running: false;
    in-out property <string> export-status: "Idle.";
    in-out property <string> export-log: "";
    in-out property <string> export-output-dir: "";

    callback export-pick-file();
    callback export-pick-folder();
    callback export-use-raw-dir();
    callback export-run();
    callback export-open-output-folder();

    // --- Hotkeys tab state (src/hotkeys.rs owns the logic). A single
    // "Toggle Recording" action (typical button-box/keybind convention:
    // one button starts if idle, stops if running) rather than separate
    // Start/Stop bindings. Keyboard binding shows as a display string
    // ("control+F1"/"unbound"); the dropdown + checkboxes below are what
    // "Set" reads to build a new one. Controller binding is pure
    // press-to-capture, so there's no corresponding input widgets — just
    // a label + Bind/Clear. ---
    in-out property <string> hotkeys-toggle-key-label: "unbound";
    in-out property <string> hotkeys-toggle-button-label: "unbound";
    in-out property <bool> hotkeys-toggle-mod-ctrl: true;
    in-out property <bool> hotkeys-toggle-mod-alt: false;
    in-out property <bool> hotkeys-toggle-mod-shift: false;
    in-out property <string> hotkeys-toggle-key-choice: "F1";
    in-out property <string> hotkeys-listening-text: "";
    in-out property <string> hotkeys-status-text: "";

    callback hotkeys-set-toggle-key();
    callback hotkeys-clear-toggle-key();
    callback hotkeys-listen-toggle-button();
    callback hotkeys-clear-toggle-button();
    // Invoked by src/hotkeys.rs's gilrs poll thread (via
    // slint::invoke_from_event_loop) once it captures the next button
    // press while binding is in "listening" mode.
    callback hotkeys-controller-captured(int, string);

    // --- Track Match tab state (src/track_match_panel.rs owns the
    // logic). Only `--refs` and the live/offline choice are exposed —
    // everything else stays acr_track_match.toml-driven. ---
    in-out property <string> track-match-refs-label: "No references selected.";
    in-out property <bool> track-match-live-mode: true;
    in-out property <string> track-match-input-path: "No input file selected.";
    in-out property <bool> track-match-running: false;
    in-out property <string> track-match-status-pill: "Idle";
    in-out property <string> track-match-status-text: "";
    in-out property <bool> track-match-offline-running: false;
    in-out property <string> track-match-offline-status: "Idle.";
    in-out property <string> track-match-log-text: "";

    callback track-match-pick-refs-files();
    callback track-match-pick-refs-folder();
    callback track-match-pick-input();
    callback track-match-start();
    callback track-match-stop();
    callback track-match-run();

    VerticalBox {
        Text {
            text: root.status-text;
            font-size: 14px;
        }

        TabWidget {
            Tab {
                title: "Status";
                VerticalBox {
                    alignment: start;
                    Text {
                        text: root.status-text;
                        font-size: 18px;
                    }
                }
            }

            Tab {
                title: "Record";
                VerticalBox {
                    alignment: start;

                    HorizontalBox {
                        Text {
                            text: "Raw output dir:";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.recorder-raw-output-dir;
                        }
                    }

                    HorizontalBox {
                        Text {
                            text: "Notes dir:";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.recorder-notes-dir;
                        }
                    }

                    HorizontalBox {
                        CheckBox {
                            text: "Record graphics (~60 Hz)";
                            checked <=> root.recorder-record-graphics;
                        }
                        CheckBox {
                            text: "Ring mode";
                            checked <=> root.recorder-ring-mode;
                        }
                    }

                    HorizontalBox {
                        Text {
                            text: "Ring slots:";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.recorder-ring-slots;
                            width: 60px;
                        }
                        Text {
                            text: "Ring prefix:";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.recorder-ring-prefix;
                        }
                    }

                    CheckBox {
                        text: "Record directly to MoTeC (no rkyv)";
                        checked <=> root.recorder-motec-mode;
                    }

                    HorizontalBox {
                        Button {
                            text: "Save";
                            clicked => { root.recorder-save(); }
                        }
                        Button {
                            text: "Start";
                            enabled: !root.recorder-running;
                            clicked => { root.recorder-start(); }
                        }
                        Button {
                            text: "Stop";
                            enabled: root.recorder-running;
                            clicked => { root.recorder-stop(); }
                        }
                    }

                    Text {
                        text: root.recorder-status-pill;
                        font-size: 14px;
                    }
                    Text {
                        text: root.recorder-status-text;
                    }

                    ScrollView {
                        height: 140px;
                        TextEdit {
                            text: root.recorder-log-text;
                            read-only: true;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Tab {
                title: "Export";
                VerticalBox {
                    alignment: start;

                    Text {
                        text: "Input";
                        font-weight: 700;
                    }
                    HorizontalBox {
                        Button {
                            text: "Pick .rkyv file…";
                            clicked => { root.export-pick-file(); }
                        }
                        Button {
                            text: "Pick folder…";
                            clicked => { root.export-pick-folder(); }
                        }
                        Button {
                            text: "Use configured raw dir (batch)";
                            clicked => { root.export-use-raw-dir(); }
                        }
                    }
                    Text {
                        text: root.export-mode-label;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Export methods";
                        font-weight: 700;
                    }
                    Text {
                        text: "MoTeC .ld is always written alongside CSV — no separate toggle needed. CSV and SQLite are run as separate acr_export invocations if both are checked (acr_export only accepts one format per run).";
                        wrap: word-wrap;
                        font-size: 11px;
                    }
                    HorizontalBox {
                        CheckBox {
                            text: "CSV (+ LD)";
                            checked <=> root.export-do-csv;
                        }
                        CheckBox {
                            text: "SQLite";
                            checked <=> root.export-do-sqlite;
                        }
                    }
                    HorizontalBox {
                        visible: root.export-do-sqlite;
                        Text {
                            text: "DB path:";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.export-sqlite-path;
                        }
                    }

                    HorizontalBox {
                        Button {
                            text: root.export-running ? "Running…" : "Run export";
                            enabled: !root.export-running;
                            clicked => { root.export-run(); }
                        }
                        Button {
                            text: "Open output folder";
                            enabled: root.export-output-dir != "";
                            clicked => { root.export-open-output-folder(); }
                        }
                    }

                    Text {
                        text: root.export-status;
                        font-weight: 700;
                    }

                    TextEdit {
                        text: root.export-log;
                        read-only: true;
                        height: 160px;
                    }
                }
            }

            Tab {
                title: "Hotkeys";
                VerticalBox {
                    alignment: start;

                    Text {
                        text: "Toggle Recording (Start/Stop)";
                        font-weight: 700;
                    }
                    Text {
                        text: "Keyboard: " + root.hotkeys-toggle-key-label;
                    }
                    HorizontalBox {
                        CheckBox {
                            text: "Ctrl";
                            checked <=> root.hotkeys-toggle-mod-ctrl;
                        }
                        CheckBox {
                            text: "Alt";
                            checked <=> root.hotkeys-toggle-mod-alt;
                        }
                        CheckBox {
                            text: "Shift";
                            checked <=> root.hotkeys-toggle-mod-shift;
                        }
                        ComboBox {
                            model: ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Space", "Enter", "Home", "End", "PageUp", "PageDown"];
                            current-value <=> root.hotkeys-toggle-key-choice;
                        }
                        Button {
                            text: "Set";
                            clicked => { root.hotkeys-set-toggle-key(); }
                        }
                        Button {
                            text: "Clear";
                            clicked => { root.hotkeys-clear-toggle-key(); }
                        }
                    }
                    HorizontalBox {
                        Text {
                            text: "Controller: " + root.hotkeys-toggle-button-label;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Bind (press button)…";
                            clicked => { root.hotkeys-listen-toggle-button(); }
                        }
                        Button {
                            text: "Clear";
                            clicked => { root.hotkeys-clear-toggle-button(); }
                        }
                    }

                    Text {
                        text: root.hotkeys-listening-text;
                        font-weight: 700;
                    }
                    Text {
                        text: root.hotkeys-status-text;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Keyboard shortcuts register at the OS level (via global-hotkey) and fire even while the game window has focus. Known trade-off: if the game itself has exclusive raw-input capture on the same controller/button-box device, this launcher may not see its button presses while the game has focus — that's a device-sharing limitation, not a bug, and isn't solved in this pass.";
                        wrap: word-wrap;
                        font-size: 11px;
                    }
                }
            }

            Tab {
                title: "Track Match";
                VerticalBox {
                    alignment: start;

                    Text {
                        text: "Reference tracks";
                        font-weight: 700;
                    }
                    HorizontalBox {
                        Button {
                            text: "Pick reference file(s)…";
                            clicked => { root.track-match-pick-refs-files(); }
                        }
                        Button {
                            text: "Pick folder…";
                            clicked => { root.track-match-pick-refs-folder(); }
                        }
                    }
                    Text {
                        text: root.track-match-refs-label;
                        wrap: word-wrap;
                    }

                    HorizontalBox {
                        CheckBox {
                            text: "Live (runs full sector timing until stopped)";
                            checked <=> root.track-match-live-mode;
                        }
                    }

                    if root.track-match-live-mode: VerticalBox {
                        alignment: start;

                        HorizontalBox {
                            Button {
                                text: "Start";
                                enabled: !root.track-match-running;
                                clicked => { root.track-match-start(); }
                            }
                            Button {
                                text: "Stop";
                                enabled: root.track-match-running;
                                clicked => { root.track-match-stop(); }
                            }
                        }
                        Text {
                            text: root.track-match-status-pill;
                            font-size: 14px;
                        }
                        Text {
                            text: root.track-match-status-text;
                        }
                    }

                    if !root.track-match-live-mode: VerticalBox {
                        alignment: start;

                        HorizontalBox {
                            Button {
                                text: "Pick .rkyv input file…";
                                clicked => { root.track-match-pick-input(); }
                            }
                        }
                        Text {
                            text: root.track-match-input-path;
                            wrap: word-wrap;
                        }
                        HorizontalBox {
                            Button {
                                text: root.track-match-offline-running ? "Running…" : "Run";
                                enabled: !root.track-match-offline-running;
                                clicked => { root.track-match-run(); }
                            }
                        }
                        Text {
                            text: root.track-match-offline-status;
                            font-weight: 700;
                        }
                    }

                    ScrollView {
                        height: 140px;
                        TextEdit {
                            text: root.track-match-log-text;
                            read-only: true;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
